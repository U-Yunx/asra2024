# ANA24 — local environment template
# --------------------------------------
# Copy this file to `.env.local` and fill in the values for local runs:
#   cp .env.example .env.local
#
# These two variables are REQUIRED for the app to connect to Supabase
# (sign-in, live market data, paper trading, payouts). Without them the app
# shows the "Supabase connection required" screen.
#
# They are PUBLIC / publishable values — safe to ship to the browser.
# Never put real secrets (API keys for AI providers, broker tokens, etc.)
# here; those belong in Supabase Edge Function secrets.
#
# The platform injects these automatically for the managed Preview and
# Production environments, so you only need this file when running the app
# yourself (e.g. `npm run dev` on your own machine or a fresh sandbox).

# Your Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xopygzpepikerwqxzqzu.supabase.co

# Your Supabase public key — either the legacy anon JWT or the newer
# publishable key (Settings → API → Project API keys).
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# --- Cloudflare Pages deployment (CI-only, optional for local runs) ---
# Auto-deploy runs from GitHub Actions (.github/workflows/deploy-cloudflare.yml)
# and deploys through the Cloudflare REST API (scripts/deploy-cloudflare.mjs).
# It needs ONE GitHub Actions secret — NOT a .env variable, NOT VITE_-prefixed,
# and never placed in .env.local. It is read only by the CI runner:
#
#   CLOUDFLARE_API_TOKEN  — Cloudflare API token with "Cloudflare Pages — Edit"
#                           permission (Dashboard -> My Profile -> API Tokens),
#                           issued on the account you want to deploy to
#                           (a fresh account works with zero extra setup).
#
# The account is resolved from the token at deploy time, and the Pages project
# "ana24" is created automatically on first deploy. There is no
# CLOUDFLARE_ACCOUNT_ID anymore — delete that old secret if you had it.
# Optional (only if your token can see multiple accounts): a plain repo
# VARIABLE named CLOUDFLARE_ACCOUNT_ID to pick the account.
#
# Add the secret under GitHub: Settings -> Secrets and variables -> Actions.
# Listed here for documentation only; do NOT fill values into this file.